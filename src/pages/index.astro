---
import LanyardCard from "@/components/LanyardCard/LanyardCard.astro";
import SocialButtons from "@/components/SocialButtons.astro";
import NarrowPageLayout from "@/layouts/NarrowPageLayout.astro";
---

<NarrowPageLayout>
  <main class="flex flex-col mt-20 px-6 font-serif gap-y-4">
    <div class="grid grid-rows-2 grid-cols-2 gap-y-4">
      <div class="">
        <h1
          class="text-4xl font-semibold basis-1/2 col-start-1 col-span-1 row-start-1 row-span-1 cool-text-gradient"
        >
          hi, i'm henrik
        </h1>
      </div>
      <SocialButtons />
      <div class="col-start-2 col-span-1 row-start-1 row-span-2 grid place-content-center">
        <!-- <LanyardCard /> -->
      </div>
    </div>

    <p class="text-base/7">
      i am a software/network/systems engineer & cs student. my primary discipline these days is technical infrastructure (infra as code, network automation) but I also do some web development and embedded work where necessary. 
      <br />
      outside of tech, i also like to unicycle, ski, and make timelapses.
      <br />
      <span class="py-2">
        i go by <code class="font-mono bg-zinc-100 dark:bg-zinc-800 p-1 mt-1 rounded-sm"
          >@henrikvtcodes</code
        > on most platforms.
      </span>
    </p>
  </main>
</NarrowPageLayout>
